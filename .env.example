# ===== PostgreSQL =====
POSTGRES_USER=hedge
POSTGRES_PASSWORD=hedge
POSTGRES_DB=hedge
# 容器内连接串（business / runtime 服务使用）
DATABASE_URL=postgresql://hedge:hedge@postgres:5432/hedge?schema=public

# ===== Workspace =====
# 容器内工作区根目录（对应命名卷 workspace_data）
WORKSPACE_ROOT=/workspace

# ===== 外部 OpenAI 兼容网关（非 compose 服务） =====
LLM_BASE_URL=https://your-gateway.example.com/v1
LLM_MODEL=your-model-name
LLM_API_KEY=sk-xxxxxxxx

# ===== 服务端口 =====
BUSINESS_PORT=3000
RUNTIME_PORT=3001
